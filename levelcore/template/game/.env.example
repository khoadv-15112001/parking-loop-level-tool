# Copy thành .env ở gốc repo (không commit). ChayDev.bat tự nạp file này.
# Giữ khớp với mục env của bi.yaml (trên BI Center các giá trị này đặt ở tab Variables).
# --- BI Level Hub + đăng nhập Google của BI. Dev và prod của BI là hai môi trường tách biệt:
# API URL, Firebase project và appId phải CÙNG môi trường. Firebase Web App config là công khai; KHÔNG đặt service-account.
__PREFIX___BI_ENV=dev
__PREFIX___BI_API_URL=https://bi-be-dev.sonatgame.com
__PREFIX___BI_APP_ID=
__PREFIX___BI_APP_ID_IOS=
__PREFIX___BI_FIREBASE_API_KEY=
__PREFIX___BI_FIREBASE_AUTH_DOMAIN=
__PREFIX___BI_FIREBASE_PROJECT_ID=
__PREFIX___BI_FIREBASE_APP_ID=
# Khoá ký phiên đăng nhập (chuỗi ngẫu nhiên dài). Trống = ngẫu nhiên mỗi lần chạy (khởi động lại = đăng nhập lại).
__PREFIX___SESSION_SECRET=
# Email admin (phẩy phân cách): chọn / tải bản game WebGL, phá khoá người khác, bật production / lưu trữ.
# Trống = chỉ máy DEV là admin (trên BI bắt buộc có).
__PREFIX___ADMINS=
__PREFIX___ALLOWED_DOMAIN=sonat.vn
# Nhận player WebGL + level từ Jenkins (hợp đồng CI v1). Token trống = tắt; cùng giá trị Jenkins secret text <slug>-level-tool-token.
# CI_BRANCH: nhánh có build tự thành bản đang dùng (trống = mọi build); CI_PACK: bộ nhận level CI (trống = bộ mặc định đầu).
__PREFIX___CI_TOKEN=
__PREFIX___CI_BRANCH=
__PREFIX___CI_PACK=
